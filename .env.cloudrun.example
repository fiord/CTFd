# CTFd Cloud Run Deployment Environment Variables
# 
# These values should be stored in Google Cloud Secret Manager
# and referenced in Cloud Run deployment

# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
# Format: postgresql+psycopg2://user:password@host/database?sslmode=require
# Get from: https://console.neon.tech/
# Choose US West region when creating database
DATABASE_URL=postgresql+psycopg2://username:password@ep-xxxxx-xxxxx.us-west-2.aws.neon.tech/ctfd?sslmode=require

# ============================================
# Redis Configuration (Upstash Redis)
# ============================================
# Format: rediss://default:password@host:port
# Get from: https://console.upstash.com/
# Choose US West region when creating database
REDIS_URL=rediss://default:AxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxX@us1-xxxxx-xxxxx.upstash.io:6379

# ============================================
# Secret Key (REQUIRED for multiple workers)
# ============================================
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-generated-secret-key-here

# ============================================
# Optional: Cloud Storage (for uploads)
# ============================================
# If you want to use Google Cloud Storage for file uploads
# Uncomment and configure these:
# UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-gcs-access-key (via HMAC for GCS)
# AWS_SECRET_ACCESS_KEY=your-gcs-secret-key
# AWS_S3_BUCKET=your-gcs-bucket-name
# AWS_S3_ENDPOINT_URL=https://storage.googleapis.com

# ============================================
# GCP Project Configuration
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
SERVICE_NAME=ctfd
